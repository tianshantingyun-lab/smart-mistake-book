    {
      "section": "神经调节",
      "aliases": [
        "神经元",
        "突触",
        "反射",
        "神经冲动"
      ],
      "conceptSummary": "神经调节的基本方式是反射；神经元间通过突触传递信息（化学递质）；静息电位与动作电位。",
      "evidenceSources": [
        "DOMAIN_COMMON_KNOWLEDGE"
      ],
      "properties": [
        "反射弧：感受器→传入→神经中枢→传出→效应器",
        "静息电位：外正内负（K+外流）",
        "动作电位：外负内正（Na+内流）",
        "突触传递：电信号→化学信号→电信号，单向",
        "兴奋在突触传递是单向的"
      ],
      "methodModels": [
        {
          "name": "电位变化分析",
          "steps": [
            "静息→K+外流",
            "刺激→Na+内流产生动作电位",
            "恢复→Na+泵出K+泵入"
          ],
          "example": "受刺激处外负内正"
        }
      ],
      "commonConfusions": [
        "兴奋在神经纤维双向、突触单向",
        "突触小体与突触区别"
      ],
      "prerequisiteRelations": [
        "需掌握细胞膜"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "神经传导分析",
          "method": "电位+突触",
          "example": "见上"
        }
      ]
