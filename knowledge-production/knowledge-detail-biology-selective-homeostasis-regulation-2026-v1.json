      ],
      "conceptSummary": "内环境是细胞外液（血浆、组织液、淋巴）；稳态是内环境理化性质保持相对稳定，靠神经-体液-免疫调节网络维持。",
      "evidenceSources": [
        "DOMAIN_COMMON_KNOWLEDGE"
      ],
      "properties": [
        "细胞外液：血浆/组织液/淋巴，构成内环境",
        "内环境理化性质：渗透压/酸碱度/温度",
        "稳态机制：神经-体液-免疫调节网络",
        "稳态意义：细胞正常代谢的前提"
      ],
      "methodModels": [
        {
          "name": "成分判断",
          "steps": [
            "细胞外液组成",
