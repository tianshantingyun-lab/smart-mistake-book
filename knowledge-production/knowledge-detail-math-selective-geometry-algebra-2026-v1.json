    {
      "section": "3.1 椭圆",
      "aliases": [
        "椭圆",
        "焦点",
        "长轴",
        "离心率"
      ],
      "conceptSummary": "椭圆是到两定点（焦点）距离之和为常数的点的轨迹；标准方程 x²/a²+y²/b²=1（a>b>0）。",
      "evidenceSources": [
        "zhihu:conic-notes"
      ],
      "properties": [
        "定义：|PF1|+|PF2|=2a",
        "a²=b²+c²（c 焦距一半）",
        "离心率 e=c/a（0<e<1）",
        "长轴2a、短轴2b、焦点(±c,0)"
      ],
      "methodModels": [
        {
          "name": "求椭圆标准方程",
          "steps": [
            "确定焦点在x轴还是y轴",
            "由条件求 a,b",
            "写标准方程"
          ],
          "example": "焦点(±2,0)且过(3,0)：a=3,c=2,b=√5"
        },
        {
          "name": "离心率计算",
          "steps": [
            "e=c/a",
            "利用 a²=b²+c²"
          ],
          "example": "a=5,b=3，c=4，e=4/5"
        }
      ],
      "commonConfusions": [
        "a,b,c 关系：a最大",
        "焦点位置决定方程形式",
        "椭圆定义是距离和"
      ],
      "prerequisiteRelations": [
        "需掌握圆"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "求椭圆方程与性质",
          "method": "定义+标准方程",
          "example": "见上"
        }
      ]
    },
    {
      "section": "3.2 双曲线",
      "aliases": [
        "双曲线",
        "焦点",
        "渐近线",
        "离心率"
      ],
      "conceptSummary": "双曲线是到两焦点距离之差的绝对值为常数的轨迹；标准方程 x²/a²-y²/b²=1，有渐近线。",
      "evidenceSources": [
        "zhihu:conic-notes"
      ],
      "properties": [
        "定义：||PF1|-|PF2||=2a",
        "c²=a²+b²（c最大）",
        "离心率 e=c/a（e>1）",
        "渐近线 y=±(b/a)x",
        "焦点(±c,0)"
      ],
      "methodModels": [
        {
          "name": "求渐近线",
          "steps": [
            "由标准方程定 a,b",
            "y=±(b/a)x"
          ],
          "example": "x²/4-y²/9=1：渐近线 y=±(3/2)x"
        },
        {
          "name": "离心率与渐近线关系",
          "steps": [
            "e=c/a=√(1+(b/a)²)",
            "由渐近线斜率求 e"
          ],
          "example": "渐近线 y=±x 时 e=√2"
        }
      ],
      "commonConfusions": [
        "双曲线 c 最大（与椭圆相反）",
        "渐近线与实轴虚轴"
      ],
      "prerequisiteRelations": [
        "需掌握椭圆"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "双曲线性质",
          "method": "标准方程+渐近线",
          "example": "见上"
        }
      ]
    },
