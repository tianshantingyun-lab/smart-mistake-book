          "example": "x²/4-y²/9=1：渐近线 y=±(3/2)x"
        },
        {
          "name": "离心率与渐近线关系",
          "steps": [
            "e=c/a=√(1+(b/a)²)",
            "由渐近线斜率求 e"
          ],
          "example": "渐近线 y=±x 时 e=√2"
        }
      ],
      "commonConfusions": [
