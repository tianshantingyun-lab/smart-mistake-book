    {
      "section": "7.1-7.2 复数的概念与运算",
      "aliases": [
        "复数",
        "虚数",
        "共轭复数",
        "复平面"
      ],
      "conceptSummary": "复数 z=a+bi（a,b∈R，i²=-1）；a 实部、b 虚部；复数可用复平面点表示；四则运算与多项式类似，用 i²=-1 化简。",
      "evidenceSources": [
        "DOMAIN_COMMON_KNOWLEDGE"
      ],
      "properties": [
        "复数相等：a+bi=c+di ⇔ a=c 且 b=d",
        "共轭复数：a+bi 与 a-bi",
        "模：|a+bi|=√(a²+b²)",
        "加法/减法对应实部虚部分别运算",
        "乘法：(a+bi)(c+di)=(ac-bd)+(ad+bc)i",
        "除法：分母乘共轭复数化去虚部"
      ],
      "methodModels": [
        {
          "name": "复数四则运算",
          "steps": [
            "按多项式展开",
            "用 i²=-1 化简"
          ],
          "example": "(1+i)(1-i)=1-i²=2"
        },
        {
          "name": "复数除法",
          "steps": [
            "分子分母同乘分母共轭",
            "化简实部虚部"
          ],
          "example": "(1+i)/(1-i)=(1+i)²/2=i"
        }
      ],
      "commonConfusions": [
        "i²=-1 易与 i³=-i、i⁴=1 混淆",
        "复数不能直接比较大小（只有模可以）",
        "z=0 的模为 0；纯虚数要求 b≠0"
      ],
      "prerequisiteRelations": [
        "需掌握实数运算与平面向量"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "复数化简",
          "method": "i 的幂化简+i²=-1",
          "example": "i³+i⁴=-i+1"
        },
        {
          "questionShape": "复数相等求参数",
          "method": "实部实部、虚部虚部相等",
          "example": "(a+bi)(1+i)=2i 求 a,b"
        }
      ]
    },
