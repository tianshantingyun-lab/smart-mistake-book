      "section": "6.1 分类加法与分步乘法计数原理",
      "aliases": [
        "加法原理",
        "乘法原理",
        "计数原理"
      ],
      "conceptSummary": "完成一件事需 n 个步骤用乘法原理（各步方法数相乘）；有 n 类办法用加法原理（各类方法数相加）。",
      "evidenceSources": [
        "zhihu:paile-zuhe-intro"
      ],
      "properties": [
        "乘法原理：N=m1·m2·...·mn（分步，各步独立）",
        "加法原理：N=m1+m2+...+mn（分类，互斥）"
      ],
      "methodModels": [
        {
          "name": "分步计数",
          "steps": [
            "识别需要几个步骤",
            "每步方法数相乘"
          ],
          "example": "10衬衣×8裤×5鞋=400搭配"
        },
        {
          "name": "分类计数",
          "steps": [
            "识别几类办法",
            "各类相加"
          ],
          "example": "北京到上海：10飞机+20高铁+30大巴+1自驾=61"
        }
      ],
      "commonConfusions": [
        "分步（乘）与分类（加）混淆",
        "步骤间必须独立"
      ],
      "prerequisiteRelations": [],
