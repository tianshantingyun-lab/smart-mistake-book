      "section": "6.2 排列与组合",
      "aliases": [
        "排列",
        "组合",
        "排列数",
        "组合数"
      ],
      "conceptSummary": "排列考虑顺序，组合不考虑顺序；排列数 A(n,m)=n!/(n-m)!，组合数 C(n,m)=n!/(m!(n-m)!)。",
      "evidenceSources": [
        "zhihu:paile-zuhe-intro"
      ],
      "properties": [
        "排列数：A(n,m)=n(n-1)...(n-m+1)",
        "组合数：C(n,m)=A(n,m)/m!",
        "组合数性质：C(n,m)=C(n,n-m)",
        "加法公式：C(n,m)+C(n,m-1)=C(n+1,m)"
      ],
      "methodModels": [
        {
          "name": "排列计算",
          "steps": [
            "判断是否考虑顺序",
            "选排列公式"
          ],
          "example": "5人选3人排成一排：A(5,3)=60"
        },
        {
          "name": "组合计算",
          "steps": [
            "判断不考虑顺序",
            "组合公式"
          ],
          "example": "5人选3人组队：C(5,3)=10"
        },
        {
          "name": "有限制排列",
          "steps": [
            "特殊元素优先处理",
            "或间接法（总数-反面）"
          ],
          "example": "A相邻问题捆绑法"
        }
      ],
      "commonConfusions": [
        "排列与组合本质区别：是否考虑顺序",
        "含限制条件时正难则反"
      ],
      "prerequisiteRelations": [
        "需掌握计数原理"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "排列组合数计算",
          "method": "套公式",
          "example": "见上"
        },
        {
          "questionShape": "有限制条件问题",
          "method": "特殊元素优先/间接法",
          "example": "见上"
        }
      ]
