      ],
      "conceptSummary": "(a+b)ⁿ 展开有 n+1 项，通项 T(k+1)=C(n,k)a^(n-k)b^k；系数为二项式系数。",
      "evidenceSources": [
        "zhihu:paile-zuhe-intro"
      ],
      "properties": [
        "二项式系数 C(n,k)，对称性 C(n,k)=C(n,n-k)",
        "所有系数和=2ⁿ",
        "奇偶项系数和相等=2^(n-1)"
      ],
      "methodModels": [
        {
          "name": "求通项",
          "steps": [
            "写出通项公式",
            "确定 k",
            "代入"
          ],
          "example": "(x+2)⁵ 中 x³ 项系数：C(5,2)·2²=40"
        },
        {
          "name": "求指定项",
          "steps": [
            "令 x 指数满足条件",
            "解出 k"
          ],
          "example": "常数项令 x 指数为0"
        }
      ],
      "commonConfusions": [
        "二项式系数与系数区别（系数含变量系数）",
