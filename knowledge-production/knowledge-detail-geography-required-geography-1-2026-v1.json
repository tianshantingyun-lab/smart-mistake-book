      "methodModels": [
        {
          "name": "气候类型判断",
          "steps": [
            "看气温曲线定温度带",
            "看降水柱状定干湿"
          ],
          "example": "全年高温多雨→热带雨林气候"
        },
        {
          "name": "天气系统分析",
          "steps": [
            "冷锋过境：阴雨降温大风",
            "暖锋过境：连续性降水升温"
          ],
          "example": "寒潮是冷锋天气"
        }
      ],
      "commonConfusions": [
