      "conceptSummary": "穿过闭合回路的磁通量变化产生感应电流；楞次定律判断感应电流方向（阻碍磁通量变化）；法拉第定律 E=nΔΦ/Δt。",
      "evidenceSources": [
        "zhihu:phy-dianci-notes"
      ],
      "properties": [
        "感应电流条件：闭合回路+磁通量变化",
        "楞次定律：增反减同、来拒去留",
        "法拉第电磁感应定律：E=nΔΦ/Δt",
        "动生电动势：E=BLv（切割磁感线）",
        "自感现象：电流变化引起自感电动势"
      ],
      "methodModels": [
        {
          "name": "感应电流方向判断",
          "steps": [
            "楞次定律：判断原磁通方向与变化",
            "增反减同定感应磁场",
            "右手螺旋定感应电流"
          ],
          "example": "磁铁插入线圈，感应电流阻碍插入"
        },
        {
          "name": "感应电动势计算",
          "steps": [
            "磁通变化型 E=nΔΦ/Δt",
            "切割型 E=BLv"
          ],
          "example": "B=0.5T,L=0.2m,v=4m/s，E=0.4V"
        }
      ],
      "commonConfusions": [
        "楞次定律与右手定则适用场景",
        "Φ、ΔΦ、ΔΦ/Δt 三个量区分",
        "自感电动势方向"
