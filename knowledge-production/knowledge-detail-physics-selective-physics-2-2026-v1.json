      "properties": [
        "正弦交流：e=Emsin(ωt)",
        "有效值：I=Im/√2，U=Um/√2",
        "周期频率：f=ω/2π",
        "变压器：U1/U2=n1/n2，P1=P2",
        "远距离输电：升压降压减少损耗"
      ],
      "methodModels": [
        {
          "name": "变压器分析",
          "steps": [
            "电压比=匝数比",
            "功率守恒求电流"
          ],
          "example": "n1:n2=10:1，U1=220V 则 U2=22V"
        },
