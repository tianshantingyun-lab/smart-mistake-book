      "section": "7.1 条件概率与全概率公式",
      "aliases": [
        "条件概率",
        "乘法公式",
        "全概率公式",
        "贝叶斯公式"
      ],
      "conceptSummary": "条件概率 P(B|A)=P(AB)/P(A)；乘法公式 P(AB)=P(A)P(B|A)；全概率公式把复杂事件分解为完备事件组上的加权和。",
      "evidenceSources": [
        "zhihu:tiaojian-quan"
      ],
      "properties": [
        "条件概率 P(B|A)=P(AB)/P(A)，P(A)>0",
        "乘法公式：P(AB)=P(A)P(B|A)",
        "完备事件组：两两互斥且并集为全集",
        "全概率公式：P(B)=ΣP(Ai)P(B|Ai)",
        "贝叶斯公式：P(Ai|B)=P(Ai)P(B|Ai)/P(B)"
      ],
      "methodModels": [
        {
          "name": "条件概率计算",
          "steps": [
            "明确条件事件 A",
            "算 P(AB) 和 P(A)",
            "P(B|A)=P(AB)/P(A)"
          ],
          "example": "抽2张牌，已知第一张红桃求第二张红桃概率"
        },
        {
          "name": "全概率公式",
          "steps": [
            "找完备事件组",
            "逐项算 P(Ai) 和 P(B|Ai)",
            "加权求和"
          ],
          "example": "多工厂产品合格率问题"
        }
      ],
      "commonConfusions": [
        "条件概率 P(B|A) 与 P(AB) 混淆",
        "完备事件组要求两两互斥且并集为全集",
        "贝叶斯公式是已知结果反推原因"
      ],
      "prerequisiteRelations": [
        "需掌握古典概型"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "条件概率",
          "method": "P(AB)/P(A)",
          "example": "见上"
        },
        {
          "questionShape": "全概率/贝叶斯",
          "method": "分解完备事件组",
          "example": "见上"
        }
      ]
    },
