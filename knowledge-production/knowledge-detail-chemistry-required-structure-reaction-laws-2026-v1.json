        "主族",
        "周期表结构"
      ],
      "conceptSummary": "元素周期表把电子层数相同的元素排成横行（周期），最外层电子数相同的排成纵行（族），共7周期16族。",
      "evidenceSources": [
        "zhihu:chem-zhouqi-gb"
      ],
      "properties": [
        "7个周期（短周期2/3、长周期4/5/6、不完全周期7）",
        "16个族（7主族+7副族+VIII族+0族）",
        "主族序数=最外层电子数",
        "周期序数=电子层数"
      ],
      "methodModels": [
        {
          "name": "元素定位",
          "steps": [
            "由原子序数排电子层",
            "确定周期与族"
          ],
          "example": "原子序数11（Na）：第三周期第IA族"
        },
        {
          "name": "周期表推断",
          "steps": [
            "结合位置推性质",
            "相邻元素比较"
          ],
          "example": "同周期从左到右金属性减弱"
        }
      ],
      "commonConfusions": [
        "主族序数与最外层电子数关系",
        "0族元素最外层8电子（He为2）"
      ],
      "prerequisiteRelations": [
        "需掌握原子结构"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "元素位置与性质",
          "method": "周期+族定位",
          "example": "见上"
        }
