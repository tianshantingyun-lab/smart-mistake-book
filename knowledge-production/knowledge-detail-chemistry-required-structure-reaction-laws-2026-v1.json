    {
      "section": "元素周期律",
      "aliases": [
        "周期律",
        "金属性",
        "非金属性",
        "递变规律"
      ],
      "conceptSummary": "元素性质随原子序数递增呈周期性变化，其根本原因是核外电子排布的周期性；同周期从左到右金属性减弱非金属性增强。",
      "evidenceSources": [
        "zhihu:chem-zhouqi-gb"
      ],
      "properties": [
        "同周期：左→右金属性减弱、非金属性增强",
        "同主族：上→下金属性增强、非金属性减弱",
        "原子半径：同周期减小，同主族增大",
        "最高正价=主族序数，最低负价=8-主族序数"
      ],
      "methodModels": [
        {
          "name": "比较金属性强弱",
          "steps": [
            "单质与水/酸反应剧烈程度",
            "最高价氧化物对应水化物碱性强弱"
          ],
          "example": "Na>Mg>Al 金属性递减"
        },
        {
          "name": "比较非金属性强弱",
          "steps": [
            "与氢气化合难易",
            "最高价氧化物水化物酸性强弱",
            "气态氢化物稳定性"
          ],
          "example": "F>Cl>Br 非金属性递减"
        }
      ],
      "commonConfusions": [
        "金属性与失电子能力（不是得电子）",
        "用最高价氧化物的水化物比较（不能用低价）"
      ],
      "prerequisiteRelations": [
        "需掌握周期表"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "元素性质比较",
          "method": "周期律递变规律",
          "example": "见上"
        }
      ]
