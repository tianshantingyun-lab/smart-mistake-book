        },
        {
          "name": "对数函数单调性",
          "steps": [
            "a>1 递增，0<a<1 递减",
            "比较大小"
          ],
          "example": "log_0.5 3 < log_0.5 2（底<1 反向）"
        }
      ],
      "commonConfusions": [
