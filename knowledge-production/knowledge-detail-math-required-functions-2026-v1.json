      ],
      "conceptSummary": "log_a N 表示以 a 为底 N 的对数（a>0,a≠1,N>0）；对数函数 y=log_a x 是指数函数的反函数。",
      "evidenceSources": [
        "DOMAIN_COMMON_KNOWLEDGE"
      ],
      "properties": [
        "对数恒等式：a^(log_a N)=N",
        "log_a(MN)=log_a M+log_a N",
        "log_a(M/N)=log_a M-log_a N",
        "log_a(Mⁿ)=n·log_a M",
        "换底公式：log_a b=log_c b/log_c a"
      ],
      "methodModels": [
        {
          "name": "对数运算",
          "steps": [
            "利用运算性质展开",
