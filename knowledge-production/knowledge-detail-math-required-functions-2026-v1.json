    {
      "section": "3.1 函数的概念及其表示",
      "aliases": [
        "函数",
        "定义域",
        "值域",
        "对应关系"
      ],
      "conceptSummary": "函数 f 是从数集 X 到数集 Y 的映射/对应关系，X 为定义域，f(x) 的取值集合为值域。",
      "evidenceSources": [
        "zhihu:fn-conc-whatis"
      ],
      "properties": [
        "函数三要素：定义域、值域、对应关系",
        "定义域是自变量的取值范围",
        "函数可用解析法/图象法/列表法表示"
      ],
      "methodModels": [
        {
          "name": "求定义域",
          "steps": [
            "分母不为0",
            "偶次根号下≥0",
            "对数真数>0"
          ],
          "example": "f(x)=1/(x-1)，定义域 x≠1"
        },
        {
          "name": "求值域",
          "steps": [
            "配方法",
            "换元法",
            "图象法"
          ],
          "example": "f(x)=x²-2x+3，值域 [2,+∞)"
        }
      ],
      "commonConfusions": [
        "定义域优先原则",
        "值域与集合表示"
      ],
      "prerequisiteRelations": [
        "需掌握集合概念"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "求定义域",
          "method": "列不等式组",
          "example": "见上"
        }
      ]
    },
    {
      "section": "3.2 函数的基本性质（单调性与最值）",
      "aliases": [
        "单调性",
        "增函数",
        "减函数",
        "最值"
      ],
      "conceptSummary": "函数单调性刻画随自变量增大函数值的变化趋势；最值是函数值的最大最小值。",
      "evidenceSources": [
        "zhihu:fn-conc-whatis"
      ],
      "properties": [
        "增函数：x1<x2 ⇒ f(x1)<f(x2)",
        "减函数：x1<x2 ⇒ f(x1)>f(x2)",
        "定义法证明单调性：作差定号",
        "复合函数单调性：同增异减"
      ],
      "methodModels": [
        {
          "name": "定义法证明单调",
          "steps": [
            "任取 x1<x2",
            "作差 f(x1)-f(x2)",
            "变形定号"
          ],
          "example": "证明 f(x)=x² 在 (0,+∞) 递增"
        },
        {
          "name": "判断复合函数单调",
          "steps": [
            "分解内层外层",
            "同增异减"
          ],
          "example": "f(x)=2^(x²-1) 的单调区间"
        }
      ],
      "commonConfusions": [
        "单调区间不能用并集连接",
        "证明单调必须用定义"
      ],
      "prerequisiteRelations": [
        "需掌握函数概念"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "判断/证明单调性",
          "method": "定义法或图象",
          "example": "见上"
        }
      ]
    },
    {
      "section": "3.2.2 函数的奇偶性",
      "aliases": [
        "奇函数",
        "偶函数",
        "对称"
      ],
      "conceptSummary": "定义域关于原点对称时：f(-x)=-f(x) 为奇函数（图象关于原点对称），f(-x)=f(x) 为偶函数（图象关于 y 轴对称）。",
      "evidenceSources": [
        "zhihu:fn-qixin-basic"
      ],
      "properties": [
        "奇函数在 x=0 有定义时 f(0)=0",
        "奇函数图象关于原点对称，偶函数关于 y 轴对称",
        "任意函数 = 偶函数部分 + 奇函数部分",
        "奇偶函数乘积：奇×偶=奇"
      ],
      "methodModels": [
        {
          "name": "判断奇偶性",
          "steps": [
            "先看定义域是否关于原点对称",
            "验证 f(-x) 与 f(x) 关系"
          ],
          "example": "f(x)=x³ 奇函数，f(x)=x² 偶函数"
        },
        {
          "name": "利用奇偶性求解析式",
          "steps": [
            "利用 f(-x) 关系",
            "分段表达"
          ],
          "example": "已知 x>0 时 f(x)=x²+x，求 f(x) 全定义域解析式"
        }
      ],
      "commonConfusions": [
        "定义域必须关于原点对称才谈奇偶",
        "f(0)=0 只对奇函数且在0有定义",
        "既奇又偶函数只有 f(x)=0"
      ],
      "prerequisiteRelations": [
        "需掌握单调性"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "判断奇偶性",
          "method": "定义域对称+f(-x)验证",
          "example": "见上"
        },
        {
          "questionShape": "奇偶性求解析式",
          "method": "分段利用对称",
          "example": "见上"
        }
      ]
    },
