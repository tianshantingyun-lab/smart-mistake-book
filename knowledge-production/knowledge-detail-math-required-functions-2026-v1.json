        "过定点 (0,1)",
        "a>1 递增，0<a<1 递减",
        "指数运算法则：a^m·a^n=a^(m+n)"
      ],
      "methodModels": [
        {
          "name": "比较大小",
          "steps": [
            "化同底",
            "利用单调性比较"
          ],
          "example": "比较 2^1.5 与 2^1.3：2^1.5>2^1.3"
        }
      ],
      "commonConfusions": [
        "底数 a>0 且 a≠1",
        "0<a<1 时单调性反向"
      ],
