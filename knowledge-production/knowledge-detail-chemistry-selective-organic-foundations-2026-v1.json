    {
      "section": "烃类化合物",
      "aliases": [
        "烷烃",
        "烯烃",
        "炔烃",
        "苯"
      ],
      "conceptSummary": "烃只含 C、H：烷烃饱和、烯烃含双键、炔烃含三键、苯是芳香烃。",
      "evidenceSources": [
        "DOMAIN_COMMON_KNOWLEDGE"
      ],
      "properties": [
        "烷烃：CnH2n+2，取代反应",
        "烯烃：CnH2n，加成反应（溴水褪色）",
        "炔烃：CnH2n-2，加成",
        "苯：CnH2n-6，易取代难加成（凯库勒式）",
        "甲烷取代、乙烯加成、苯的硝化"
      ],
      "methodModels": [
        {
          "name": "烷烃命名",
          "steps": [
            "找最长链",
            "编号（近端最小）",
            "写取代基"
          ],
          "example": "2-甲基丙烷"
        },
        {
          "name": "性质判断",
          "steps": [
            "看官能团（双键/三键加成）",
            "烷烃取代"
          ],
          "example": "乙烯使溴水褪色是加成"
        }
      ],
      "commonConfusions": [
        "苯的加成与取代条件",
        "烯烃加成产物顺反异构"
      ],
      "prerequisiteRelations": [
        "需掌握有机物概述"
      ],
      "workedExampleStructure": [
        {
          "questionShape": "烃的性质",
          "method": "官能团决定",
          "example": "见上"
        }
      ]
    },
    {
      "section": "含氧有机物（醇醛酸酯）",
      "aliases": [
        "乙醇",
        "乙酸",
        "醛",
        "酯",
        "官能团转化"
      ],
      "conceptSummary": "醇（-OH）、醛（-CHO）、羧酸（-COOH）、酯（-COO-）之间的转化是核心：醇氧化→醛→羧酸，酸醇酯化→酯。",
      "evidenceSources": [
        "DOMAIN_COMMON_KNOWLEDGE"
      ],
      "properties": [
        "乙醇：与Na反应、催化氧化成乙醛",
        "乙醛：银镜反应、被氧化成乙酸",
        "乙酸：酸性、酯化反应（浓硫酸催化）",
        "酯化：酸+醇→酯+水，可逆",
        "官能团转化链：醇→醛→羧酸→酯"
      ],
      "methodModels": [
        {
          "name": "有机合成路线",
          "steps": [
            "确定目标官能团",
            "找转化反应",
            "设计路线"
          ],
          "example": "乙烯→乙醇→乙醛→乙酸→乙酸乙酯"
        },
        {
          "name": "官能团性质",
          "steps": [
            "看官能团定反应类型"
          ],
          "example": "醛基有还原性（银镜）"
        }
      ],
      "commonConfusions": [
        "酯化反应条件与可逆性",
        "醛氧化成酸需强氧化剂"
      ],
      "prerequisiteRelations": [
        "需掌握烃类"
      ],
      "workedExampleStructure": [
