      "section": "有机化合物概述",
      "aliases": [
        "有机物",
        "官能团",
        "同分异构",
        "命名"
      ],
      "conceptSummary": "有机化合物以碳为主，含 C、H、O、N 等；官能团决定化学性质；同分异构体分子式相同结构不同。",
      "evidenceSources": [
        "DOMAIN_COMMON_KNOWLEDGE"
      ],
      "properties": [
        "有机物特点：种类多、熔沸点低、易燃、反应慢",
        "官能团：羟基-OH、醛基-CHO、羧基-COOH、酯基",
        "同分异构：碳链异构/位置异构/官能团异构",
        "系统命名：最长碳链+编号"
      ],
      "methodModels": [
        {
          "name": "官能团识别",
          "steps": [
            "找特征原子团",
            "判断类别"
          ],
          "example": "含-COOH 是羧酸"
        },
        {
          "name": "同分异构数",
          "steps": [
            "先碳链异构",
            "再位置异构"
          ],
          "example": "C4H10 有 2 种结构（正丁烷/异丁烷）"
        }
      ],
      "commonConfusions": [
        "官能团决定性质（不是碳骨架）",
        "同分异构与同系物区别"
      ],
      "prerequisiteRelations": [],
      "workedExampleStructure": [
        {
          "questionShape": "官能团/异构判断",
          "method": "结构分析",
          "example": "见上"
        }
      ]
